# ============================================================
# Python
# ============================================================

__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# Virtual environments live outside the repo (C:\tmp\prophesee,
# C:\tmp\akida, C:\tmp\ultra) but ignore them in case one is ever
# created here by accident.
venv/
.venv/
env/


# ============================================================
# Editors and OS
# ============================================================

.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db


# ============================================================
# Bulk data -- excluded by FILE PATTERN, not by directory
# ============================================================
#
# Deliberately not written as `Data_new/tensors*/`. Git does not
# descend into an excluded directory, so a later `!*.pdf` cannot
# rescue a file inside one -- it is simply never seen. Excluding the
# file types instead keeps the small documents and metadata visible
# wherever they happen to sit.

# Tensors, events, images, video, audio.
*.npy
*.npz
*.dat
*.mp4
*.avi
*.wav
*.mat
*.xlsx

# Per-clip tensor metadata -- 114 files per folder, regenerated by the
# build scripts, and the interesting parts are in the run JSONs.
*_meta.json
manifest.json

# Archives built for upload to Colab or Kaggle.
*.zip

# Model weights: too large for git, reproducible by retraining, and
# kept in Drive. The metrics ARE committed -- see below.
*.h5
*.pt
*.pth
*.keras
*.tflite
*.fbz


# ============================================================
# Source dataset -- 339 MB, immutable, CC0, re-downloadable
# ============================================================
#
# https://doi.org/10.5281/zenodo.5500576
# The README says where to get it. Its own README and the MATLAB
# example script are small and worth keeping.

Data_raw/Audio/
Data_raw/Video_IR/
Data_raw/Video_V/


# ============================================================
# Generated image sets
# ============================================================
#
# 35,496 jpgs and their label txts, rebuilt in ~15 minutes by
# build_rgb_tensors.py --format yolo. data.yaml points at a local
# Windows path, so it is regenerated rather than committed.

Data_new/tensors_rgb/yolo26_rgb_224_ultralytics/

# Ultralytics label-scan cache. Contains absolute paths, so it breaks
# on any other machine.
*.cache

# Rendered verification frames -- 297 PNGs. The three comparison PDFs
# built from them are committed instead.
Data_new/verification/V_DRONE_*/


# ============================================================
# Explicitly kept, in case a broader rule is added later
# ============================================================
#
# splits.json defines the 90/12/12 clip-level division. Every result in
# every report depends on it, and regenerating with a different seed
# would silently invalidate all of them. The single most important
# small file here.
!Data_new/splits.json

# The label CSVs are the MATLAB export. Reproducing them needs a MATLAB
# licence and the Computer Vision Toolbox, for 2 MB of text.
!Data_new/labels/*.csv

# Run metrics and Ultralytics figures.
!Data_new/runs/**/*.json
!Data_new/runs/**/*.csv
!Data_new/runs/**/*.yaml
!Data_new/runs/**/*.png
!Data_new/runs/**/*.jpg

# Documents, wherever they sit.
!*.md
!*.pdf
!*.txt


# ============================================================
# Scratch
# ============================================================

*.log
tmp/
scratch/
fix_paths.py

Data_new/runs/**/errors_*/